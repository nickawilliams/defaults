{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@nickawilliams/defaults-typescript",
  "version": "0.5.0",
  "description": "default typescript configurations",
  "keywords": [
    "typescript",
    "defaults"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nickawilliams/defaults.git",
    "directory": "packages/typescript"
  },
  "license": "BSD-2-Clause",
  "author": "Nick Williams <git@nickawilliams.com>",
  "type": "module",
  "exports": {
    ".": "./etc/base.json",
    "./*": "./etc/*.json"
  },
  "bin": {
    "init-defaults-typescript": "./bin/init"
  },
  "files": [
    "bin",
    "etc"
  ],
  "peerDependencies": {
    "typescript": "^5.7.3 || ^6.0.0 || ^7.0.0"
  },
  "engines": {
    "bun": ">=1.2.0"
  },
  "publishConfig": {
    "access": "public"
  }
